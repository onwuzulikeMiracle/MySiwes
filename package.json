{
  "name": "student-attendance-tracker",
  "version": "1.0.0",
  "description": "Student Attendance & Behaviour Tracker (offline, SQLite via sql.js, packaged with Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-packager . StudentTracker --platform=win32 --arch=x64 --out=dist --overwrite",
    "package-linux": "electron-packager . StudentTracker --platform=linux --arch=x64 --out=dist --overwrite",
    "package-mac": "electron-packager . StudentTracker --platform=darwin --arch=x64 --out=dist --overwrite"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2"
  }
}
